// =====================================================================
//  系統A — 低域クラスタのうなりが震えになる
// =====================================================================
//
//  対象は参照(やくしまるえつこ plays dimtakt)の **0.3-9.0秒** のみ。
//
//  --- 対象区間を取り違えていた ---
//
//  当初は自動区分が出した 0-22秒 を一つの系統として扱っていたが、この22秒には
//  性質の全く違う3つの音が入っている。測り分けると次のようになる。
//
//      区間      周期       160-300Hz  300-600Hz  変調の主帯域     深さ
//      0-9s     190.9Hz      70.1%       2.6%     20-60Hz 59%     0.38
//      9-15s     46.2Hz       6.6%      18.7%     60-100Hz 65%    0.79
//      15-22s    59.5Hz        0.7%     85.7%     0.2-1Hz 83%     1.33
//
//  **46Hzのパルス列という前稿の設計は、除外すべき9-15秒の性質だった。**
//  9-15秒は800→700→600→500→430Hzと新しい線が降りてくる旋律的な経過で、
//  持続するテクスチャではない。3つを平均していたため、部分音表もレベルも
//  変調統計もすべて汚染されていた。
//
//  --- 構造: 震えはうなりである ---
//
//  0-9秒のエネルギーは 185.7Hz(1.000) / 201.9Hz(0.588) / 231.5Hz(0.629) の
//  3本に77.9%が集中し、300-1200Hzは合わせて4.5%しかない。1526/1709Hzに
//  別のクラスタが17.5%。**低域の密集と高域の対の二峰で、間は空である。**
//
//  この3本の間隔は 16.1Hz・29.6Hz・45.8Hz で、実測した変調の主帯域
//  (8-20Hz 23.5% / 20-60Hz 59.1%)とそのまま一致する。つまり**震えは
//  別の変調器ではなく、低域クラスタどうしのうなりそのものである。**
//  だから震えは音から独立しない。
//
//  波形は周期190.9Hz(5.2ms)・周期内の波高率1.93(正弦波は1.41)でほぼ滑らか。
//  パルス列ではないので角が立たない。
//
//  --- 0.092Hzの回転について ---
//
//  **この区間には適用しない。** 回転は不均質な22秒全体から測った値で、周期
//  10.9秒は8.7秒の区間に収まらない。3つのテクスチャの移り変わりを回転と
//  読んでいた可能性が高く、0-9秒単独では検証できない。ごく浅い揺らぎだけ残す。
//
//  --- 追う値 (0.3-9.0秒の実測) ---
//
//      RMS -17.5dB / ピーク -5.9dB / 波高率 3.37
//      160-300Hz 70.1% / 300-600Hz 2.6% / 1200-2400Hz 19.6% / 重心 537Hz
//      周期 190.9Hz・相関+0.707 / 周期内の波高率 1.93
//      変調 8-20Hz 23.5%・20-60Hz 59.1% / 変調の深さ 0.38
//      独立に動く成分の実効数 5.2/14本 / LR相関 0.724・Side 14.31%
//
~makeSysABankDef = {
	SynthDef(\sysABank, { |out = 16, amp = 0.5,
		// 部分音ごとの周波数の揺れ [cent] と速さ [Hz]。スペクトログラム上で
		// 参照の線は静止していない。**大きくしすぎるとうなりの速さがぶれて
		// 震えが不安定になる**(うなりは3本の周波数差そのものなので)
		// **周波数の揺れは実装されていない。** 群をKlangにした時点で周波数が
		// 初期化時固定になり、jitter引数は死んでいた(渡しても何も起きない)。
		// 「30centが効いた」という以前の観測は乱数の実行間ばらつきで、
		// 類似度0.9944と0.9965の差はそれで説明がつく。動かすならDynKlangへ
		// 置き換えが必要で、未着手。
		// 振幅のゆらぎの深さと速さ。参照の変調の深さは0.38と浅い。深くすると
		// 15-22秒側(深さ1.33)の性格へ寄る
		wander = 0.80, wanderHz = 0.18,
		// 全体が共通に息をする量。**共通なので震えを分離させない**
		swell = 0.40, swellHz = 0.11,
		stereoAmt = 0.50,     // 左右の独立成分の割合。LR相関0.724・Side 14.3%に対応

		panWidth = 0.70,      // 部分音ごとの定位の広がり。Side 14.3%に合わせる
		// 「杖の傾き」。どの共鳴が鳴るかをゆっくり移動させる。**これが無いと
		// 全部が常時鳴って混ざりすぎる。** 実測では、瞬間の実効本数÷時間平均が
		// 参照0.65に対し固定版は0.95(＝瞬間も平均と同じだけ鳴っている)、
		// スペクトル形の時間変化は参照0.9881に対し0.9973でほぼ静止、成分の
		// 出入りの幅も参照28.5dBに対し16dBしかなかった。
		// 対数周波数上を動く2つのガウス窓で、当たっている所だけを鳴らす。
		// **低域クラスタには掛けない。** 傾きで土台まで消すと、常時鳴っている
		// 芯が無くなって音が軽くなり「はっきりした部分がない」状態になる。
		// 参照の160-250Hzは全エネルギーの67%を占め、NMFのどの成分にも
		// 183-205Hzの山が入っている＝この帯域は通して鳴っている。
		gestureHz = 0.13,     // 傾きの速さ
		gestureWidth = 1.20,  // 窓の幅 [oct]
		gestureFloor = 0.12,  // 窓の外の残り(中高域のみ)
		// 傾きの平均減衰の補償。**これが無いと中高域が平均的に下がる。** 窓は
		// 5.8オクターブの範囲を2本で動くので、ある部分音に当たっている時間は
		// 一部しかない。補償なしでは1200-2400Hzが19.6%から2.3%へ落ち、
		// 重心も537Hzから252Hzへ暗くなった
		gestureComp = 3.2,
		// 谷を埋める連続成分の量。**増やしても形は動かない。** 0.15まで上げると
		// 広帯域で形が安定しているぶん類似度が0.9976へ戻り、山の本数も潰れた
		floorAmp = 0.04,
		hpf = 30|             // 参照は44Hzまで成分を持つ            // 185.7Hzより下は空(40-160Hzは0.7%しかない)
		// 参照 0.3-9.0秒の実測部分音とレベル(最強を1.0とした振幅)。
		// **エネルギーの集中がこの音の本体である。** 以前の稿は160-300Hzが
		// 25-30%しかなく、参照の70%に対して散りすぎていた。
		// 160Hz以下と139-178Hzの成分。**v8まではここが完全にゼロだった。**
		// 参照は 25-50Hz 0.037% / 50-80Hz 0.060% / 80-120Hz 0.103% /
		// 120-160Hz 0.498% を持つ。量は少ないが、無いと下が抜ける。
		// 139-178Hzは密集していて、その間隔26Hz・29.6Hzが実測の
		// 「100-160Hzの変調が20-60Hzに72.6%」を作っている。
		var freqs = [44.1, 49.5, 66.6, 73.3, 90.5, 95.9,
			139.3, 148.7, 156.1, 165.5, 168.6, 178.3,
			185.7, 201.9, 231.5, 339.1, 473.7, 551.8, 602.9, 691.8,
			907.1, 1025.5, 1154.7, 1289.3, 1426.6, 1526.2, 1709.2, 1981.1];
		// 帯域の実測差から補正した値。**実測は耳の評価と一致した** —
		// 1200-2400Hzが32.4%(参照19.6%)で明るすぎ、160-300Hzが57.5%(70.1%)で
		// 芯が足りないという測定に対し、試聴も「まだ明るい・芯が足りない」
		// だった。40-160Hzを×1.5、160-300Hzを×1.15、300-600Hzを×0.80、
		// 600-1200Hzを×1.11、1200-2400Hzを×0.70。
		var levels = [0.0113, 0.0258, 0.0198, 0.0306, 0.0368, 0.0522,
			0.0384, 0.1242, 0.0356, 0.0685, 0.0324, 0.0323,
			1.150, 0.676, 0.723, 0.041, 0.057, 0.117, 0.166, 0.157,
			0.145, 0.152, 0.178, 0.137, 0.144, 0.406, 0.601, 0.036];		// 定位の配置。低域クラスタ(0-2)は互いに近く左、高域の対(13-14)は右
		// 定位。本数より短ければ巡回して使う
		var panTab = [-0.42, -0.30, -0.50, 0.35, -0.20, 0.45, -0.35, 0.30,
			-0.45, 0.40, -0.25, 0.50, -0.30, 0.62, 0.55, 0.40];
		var n = freqs.size;
		// 中高域を「群」にする。**参照の部分音は単線ではない。** 0.67Hz分解能で
		// 拡大すると、692Hzは6本、907Hzは9本、1155Hzは±37Hzの中に15本の山が
		// 立っている。単線を1本置くとその帯域は完全に静止し、実測でも中高域の
		// 8-20Hz変調が参照23.3%に対し0.2%しか出なかった。群の中で互いにうなる
		// ことで全帯域が震える。低域(186/232)だけは参照でも澄んだ単線なので
		// 群にしない。
		// **これらはSynthDefの引数にできない。** 群の本数は配列の長さになるので
		// コンパイル時に決まっていなければならず、引数(UGen)を渡すと組み立てが
		// 固まる(エラーも出ずsclangが応答しなくなる)。
		var clusterFrom = 300;
		var clusterN = 12;
		// **0.06まで広げてはいけない。** 参照の実測の広がりは692Hzで±25Hz、
		// 1155Hzで±37Hz、つまり中心の約3%。0.06にすると1200-2400Hzの
		// エネルギーが19.6%から8.7%へ散り、うなりも速い側(20-60Hz 86%)へ寄る。
		// 密度は広がりではなく本数で上げる。
		var clusterSpread = 0.03;
		var voices, sig, breath, gpos;

		// 全体の息。ひとつのLFNoiseを全部分音へ共通に掛ける
		breath = 1 - swell + (swell * LFNoise1.kr(swellHz).range(0, 1));
		// 傾きの位置(対数周波数)。2本あるので複数の領域が同時に鳴りうる。
		// 参照の瞬間の実効本数は6.6で、1本では疎すぎ、3本以上では混ざる
		gpos = [
			LFNoise2.kr(gestureHz).range(log2(40), log2(2200)),
			LFNoise2.kr(gestureHz * 0.73).range(log2(40), log2(2200))
		];

		voices = freqs.collect { |f, k|
			// この部分音を構成する本数。低域(186/232)は参照でも澄んだ単線
			var nc = (f < clusterFrom).if({ 1 }, { clusterN });
			// 中心からのずれ [Hz]。等間隔にするとうなりが単一の速さに揃って
			// 機械的になるので、正弦で不均等に配る
			var offs = Array.fill(nc, { |i|
				(nc == 1).if({ 0.0 }, {
					f * clusterSpread * sin((i * 2.399963) + (k * 1.7))
				})
			});
			// 中心から離れるほど弱くする
			var wts = offs.collect { |o|
				1 / (1 + (2 * (o / (f * clusterSpread + 1e-9)).abs))
			};
			// **振幅の和で割ってはいけない。** 群の成分は無相関に足し合わさるので
			// パワーが加算される。和で割ると7本の群は単線より7倍弱くなり、
			// 中高域が19.6%から4.3%へ潰れた。二乗和の平方根で揃える
			var norm = (wts.collect { |w| w * w }.sum).sqrt;
			// 低域クラスタは土台として常時鳴らし、傾きと揺れを免除する
			var isLow = f < clusterFrom;
			var lf = log2(f);
			var spot = gpos.collect { |gp|
				(((lf - gp) / gestureWidth).squared.neg).exp
			}.reduce(\max);
			var gate = isLow.if({ 1.0 },
				{ (gestureFloor + ((1 - gestureFloor) * spot)) * gestureComp });
			// 土台のゆらぎは浅く。**芯をはっきりさせるには動かしすぎない。**
			// 全体の変調の深さも参照0.38に対し0.55と過大だった
			var wob = isLow.if({ 0.22 }, { wander });
			var amp2 = gate * (1 - wob + (wob *
				LFNoise1.kr(wanderHz * (0.6 + (0.8 * k / n))).range(0, 1)));
			// 群を作る。**SinOscを並べてはいけない。** 16本×7個×左右で250個を
			// 超えるとSynthDefが32KBを越え、scsynthのOSC受信バッファに入らず
			// 丸ごと捨てられる。症状は「無音のwavが書き出される」だけで、
			// エラーも警告も出ない。Klangは1つのUGenで正弦波の束を出す。
			var bank = { |shift, phOff|
				Klang.ar(`[
					offs.collect { |o| (f + o) * shift },
					wts,
					offs.collect { |o, i| (pi * k * k / n) + phOff + (i * 1.3) }
				]) / norm
			};
			// 共通成分と、左右それぞれ独立の成分。周波数をわずかにずらすと
			// 時間とともに位相関係が変わり、左右が非相関になる
			var common = bank.(1.0, 0.0);
			var indL = bank.(1.0 + 0.0004, 0.7);
			var indR = bank.(1.0 - 0.0004, 1.4);
			var g = panWidth * panTab[k % panTab.size];
			// **左右の独立成分の量は周波数で変える。** 参照の左右コヒーレンスは
			// 120-240Hzで0.844、960-1920Hzで0.605と、低いほど揃っている。
			// 一律にすると低域が0.546まで崩れた
			var sa = stereoAmt * (f / 1000).clip(0.60, 1.0);
			var mixL = ((common * (1 - sa)) + (indL * sa)) * amp2;
			var mixR = ((common * (1 - sa)) + (indR * sa)) * amp2;
			[mixL * (1 - (g * 0.5)), mixR * (1 + (g * 0.5))] * levels[k]
		};

		sig = voices.sum;
		// 山と山の間を埋める連続した床。**これが無いと谷が完全に空になる。**
		// 山と中央値の比は参照が120-240Hzで3253に対し、床なしの版は
		// 13,552,583(桁が4つ違う)。参照の谷はピークの-26〜-39dBにあり、
		// そこに連続成分が存在する。**平坦な広帯域ノイズではいけない**
		// (試聴で「耳障りなサー」として却下済み)。参照のスペクトル形に沿わせ、
		// 低中域に寄せて3kHzで切る
		sig = sig + (
			[200, 650, 1600].collect { |fc, i|
				// **低域に寄せてはいけない。** 音本体が既に160-300Hzに70%を
				// 置いているので、床も低域に寄せると160-300Hzが83.7%まで
				// 膨らみ、1200-2400Hzが14.8%から8.7%へ相対的に潰れた
				BPF.ar(WhiteNoise.ar ! 2, fc, 0.7) * [0.30, 0.55, 0.70][i]
			}.sum * floorAmp
		);
		sig = sig * breath;
		sig = LPF.ar(sig, 3000);
		sig = HPF.ar(sig, hpf);
		Out.ar(out, sig * amp);
	})
};
