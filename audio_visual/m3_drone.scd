// =====================================================================
//  M3: 線層 — 広がりを持つ持続音
// =====================================================================
//
//  試聴で「出来事だけだと物足りない、ずっと鳴ってる深い音が欲しい」という
//  要求が出た。ただし続く試聴で「深いというのは単純に低い音という感じでは
//  ない、広がりと言ってもいい」と補足された。**この層が担うのは低音ではなく
//  空間的な拡がりである。**
//
//  最初の実装は470.24Hz(回路由来)の3オクターブ下58.78Hzを土台に置き、
//  320Hzで蓋をして低域に留める設計だった。これは「深い=低い」という誤読で、
//  試聴では「小さすぎて変化が分からない」と評された。音量が足りなかった
//  だけでなく、低域に閉じ込めたことで広がりが出ようがなかった。
//
//  作り直した方針:
//    - 音域を2〜3オクターブへ広げる(低域に閉じ込めない)
//    - 部分音ごとに独立した非常に遅い音量の膨らみを与える。これが
//      「呼吸している持続音」を作る。周期は20〜100秒で、粗さ(20-300Hz)
//      にも変化率(数秒)にもかからない遅さに留める
//    - 部分音を左右に振り分ける。同じ音を複製せず別の発振器を割り当てる
//      ことで、うなりの位相が左右で揃わず自然な広がりになる
//
//  発振器は正弦のみ。ノイズ励起にすると包絡線が揺れて連続体層と同じ
//  「蜂の羽ばたき」になる(amp 0.04まで下げても性質は変わらなかった)。
//  ノコギリやパルスにすると倍音が中高域まで伸びて出来事層と場所を取り合い、
//  「かたい」音になる。滑らかさと広がりの両立には正弦波の重ね合わせが要る。
//
//  音程は回路定数から導く。[[audio_visual/聴覚演出は回路クロック分周の純正律ドローンと連続グライドする記憶の声で構成する.md]]
//  が $R=117\Omega$・$C=71\text{nF}$ から導いた $470.24$ Hz を基準とし、
//  その3オクターブ下 $58.78$ Hz を最低音に置く。演出のために選んだ数値では
//  なく回路が実際に持っている周期である。
//
//  ---- この層で壊してはいけないもの ----
//
//  変化しない層を足すと、変化する層の**相対的**な変動が薄まる。連続体層を
//  amp 0.04 混ぜただけでスペクトル変化率のSDが 0.070 -> 0.038 へ半減した
//  実測がある。加えたあと必ず変化率のSDを測り直すこと。
//

~makeDroneDef = {
	SynthDef(\drone, { |out = 0, amp = 0.5,
		baseFreq = 58.78,      // 470.24Hz(回路由来)の3オクターブ下
		detune = 0.13,         // うなりの速さ [Hz]
		swellHz = 0.02,        // 音量の膨らみの速さ。0.02なら50秒周期
		swellAmt = 0.55,       // 膨らみの深さ。0で膨らまない
		stretch = 1.08,        // 部分音を非調和に開く量。1.0=純正律
		tilt = 0.75,           // 高い部分音の減衰。小さいほど明るい
		cutoff = 2200,         // 上の蓋。出来事層の場所を空けるため完全開放はしない
		width = 1.0,           // 左右の振り分け幅
		lag = 0.5|

		var ratios, n, f, sig, swell, pans, l, r;

		baseFreq = Lag.kr(baseFreq, lag);
		amp = Lag.kr(amp, lag);

		// ---- 純正律で2〜3オクターブに広げる ----
		// 1 / 5/4 / 3/2 / 2 / 5/2 / 3 / 4 / 5 。低音の土台ではなく
		// 帯域全体に薄く広がる持続音にするための配置。
		// **0.5(29.4Hz)を外してある。** 30Hz以下は音程ではなく脈動として
		// 知覚され、試聴で「ヘリコプターみたい」と評された主因だった。
		//
		// **stretchで非調和に開く。** 純正律のまま重ねると、部分音どうしの
		// 差音がすべて 14.7Hz(=58.78/4) の整数倍に揃って強め合い、包絡線が
		// 29.4Hzで強く脈動する。実測で変調の突出が 90.7dB に達し、参照録音の
		// 15〜20dB に対して桁違いだった。わずかに非調和にすると差音が散らばり、
		// 周期的な脈動が消えてゆらぎに変わる。回路由来の基音は保ったまま、
		// 部分音の比だけを開く形にしている(stretch 1.0で純正律に戻せる)。
		// **低域は疎に、高域は密に。** 部分音どうしの差の周波数が脈動として
		// 聞こえるので、低い側で隣どうしを近づけてはならない。1:5/4:3/2 と
		// 並べると基音58.78Hzでは隣が14.7Hz差になり、そのまま脈動になる。
		// オクターブ間隔から始めれば最小の差が基音そのもの(58.8Hz)になり、
		// 脈動の帯域(3-40Hz)を完全に抜ける。純正律は保たれている。
		ratios = [1, 2, 3, 4, 6, 8, 10, 12].collect({ |ra| pow(ra, stretch) });
		n = ratios.size;

		// 各部分音をわずかにずらして2本ずつ重ねる。ずれがうなりを生む。
		f = ratios.collect({ |ra, i| baseFreq * ra }) ++
		    ratios.collect({ |ra, i| (baseFreq * ra) + (detune * (1 + (i * 0.21))) });

		// ---- 部分音ごとに独立した遅い膨らみ ----
		// 速さを部分音ごとにずらすので、全体が同時に膨らむことがない。
		// これが「呼吸している」感じの正体で、和音の構成が刻々と入れ替わる。
		swell = f.collect({ |x, i|
			1 - swellAmt + (swellAmt * SinOsc.kr(swellHz * (1 + (i * 0.37)), i * 0.7).range(0, 1))
		});

		sig = SinOsc.ar(f) * swell * ratios.collect({ |ra| pow(ra, tilt.neg) }).dup.flatten;

		// ---- 左右へ振り分ける ----
		// 部分音を交互に振り分け、うなりの相手を反対側へ置く。
		l = sig[(0..(n*2-1))].select({ |x, i| i.even }).sum;
		r = sig[(0..(n*2-1))].select({ |x, i| i.odd }).sum;
		sig = [
			(l * (1 - (width * 0.5))) + (r * (width * 0.5)),
			(r * (1 - (width * 0.5))) + (l * (width * 0.5))
		] * 0.12;

		sig = LPF.ar(sig, cutoff.clip(100, 12000));
		sig = LeakDC.ar(sig);
		Out.ar(out, sig * amp);
	})
};
