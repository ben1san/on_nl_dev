// =====================================================================
//  M4: グライド層 — 連続的に滑走する声
// =====================================================================
//
//  測定で判明した、参照(dimtakt)とこちらの音を分ける唯一の量:
//
//      音源                    軌跡の自己相関   重心のばらつき
//      dimtakt 4区間            +0.22 〜 +0.39   0.36 〜 1.57
//      こちらの出来事層(好評)     -0.008          1.333
//      こちらの連続体層           +0.238          0.204
//
//  dimtaktは「大きく動き、かつ滑らかに動く」。出来事層は動く量は同等なのに
//  1フレームごとに無関係な高さへ飛ぶ。連続体層は滑らかだが動かない。
//  どちらも片方しか満たしていなかった。
//
//  同じ明るさでも、**グライドして到達した高域と、いきなり出現する高域は
//  別物に聞こえる**。出来事層を明るくしたら「聴きごこちが悪くなった」のに、
//  10倍明るいdimtaktが良い理由がこれで説明できる。エネルギー量の指標では
//  区別できなかった差が、軌跡の連続性に出る。
//
//  この層は [[audio_visual/聴覚演出はノーバッファの連続グライド楽器として記憶の中身相関を担う.md]]
//  が最初に決めていた設計そのものである:
//
//    > ブロックごとに新しい音を都度トリガーするのではなく、常時鳴り続ける
//    > 一本のオシレーターを、ブロックが来るたびに次の目標値へポルタメントで
//    > 滑らかに追従させる。
//
//  M2の出来事層はこの決定に反して独立な乱数で毎回新しい音を撃つ設計だった。
//  測定が独立に元の決定へ戻ってきた形になる。
//
//  ---- 3つの性格 ----
//
//  dimtaktは複合的で、区間によって2-8kHzが1.28%から39.70%まで30倍違う。
//  平均を狙うと何にも似ない音になるので、1つの楽器を3通りに鳴らす形にした。
//  presetパラメータではなく、呼び出し側が引数で作り分ける(下部に既定値を記載)。
//
//    きんきん: 高い基音・強いFM・非調和な変調比。金属質で刺さる
//    深み    : 低い基音・弱いFM・ゆっくりした滑走。太く沈む
//    ぴこぴこ: 速い目標更新・短い滑走時間・強い振幅アクセント。跳ねる
//
//  いずれも音程は必ず滑走で繋がる。跳ねる場合(ぴこぴこ)も、滑走時間を
//  短くするだけで不連続にはしない。
//

~makeGlideDef = {
	SynthDef(\glide, { |out = 0, amp = 0.3,
		baseFreq = 235.12,     // 470.24Hz(回路由来)の1オクターブ下
		targetRate = 1.1,      // 1秒あたり何回、次の目標音程を決めるか
		glideTime = 0.55,      // 目標へ滑走する時間 [s]。長いほど常に動いている
		rangeLo = 0.5,         // 目標音程の範囲(baseFreqに対する倍率)
		rangeHi = 4.0,
		fmIndex = 2.5,         // FMの深さ。上げるほど金属質で「きんきん」する
		modRatio = 2.41,       // 変調比。非整数だと非調和=金属質
		accent = 0.5,          // 目標更新時の振幅アクセントの強さ
		accentDur = 0.25,      // アクセントの減衰時間 [s]
		floorLevel = 0.45,     // アクセントの谷でも残る音量。0にすると途切れる
		bright = 1.0,          // 出力の明るさ(フィルタの開き)
		swellHz = 0.05,        // ゆっくりした音量のうねり
		width = 0.6,
		// ---- 回転制御 ----
		rotor = 1.0,           // 1=回転で駆動 / 0=乱数の目標を滑走(旧方式)
		rotorHz = 0.08,        // 回転の基準速度。4枚の平面はこの通約でない倍数で回る
		rotorRange = 0.5,      // **音程**の振れ幅[オクターブ]。有界なのでこれが上限になる。
		                       // 試聴で「変化が激しいのは音程」と指摘された。軌跡の
		                       // ばらつきをここで稼ぐとサイレン状の掃引になる。参照の
		                       // きんきん区間はばらつき0.359と最小で、動いているのは
		                       // 音程ではなく音色である。小さく保つこと。
		timbreAmt = 1.8,       // 回転が**音色**(FM深さ・明るさ)を動かす量。
		                       // ばらつきはこちらで稼ぐ。音程と違い耳障りにならない。
		lag = 0.2|

		var trig, target, freq, mod, car, sig, env, cut, pan, detA, detB;
		var rates, coss, sins, coords, wc, ws, randTarget, rotTarget;

		trig = Dust.kr(targetRate);

		// =============================================================
		//  9次元回転による制御
		// =============================================================
		//  n次元の回転(SO(n)の元)は、必ず floor(n/2) 枚の互いに直交する
		//  平面での同時回転に分解できる(実正規形)。9次元なら4枚の平面と
		//  固定軸1本。したがって「9次元球の回転」は、具体的には互いに
		//  通約でない4つの速度を持つ4-トーラス上の準周期運動であり、
		//  9本の制御信号はその軌道を9方向へ射影したものになる。
		//
		//  この構造は、測定で見つかった判別条件をそのまま満たす:
		//    - 軌道が連続        -> 軌跡の自己相関が正になる
		//    - 有界              -> 「変化が激しい」が起きない
		//    - 通約でない速度    -> 厳密には決して繰り返さない
		//    - 9本が同じ4速度を位相違いで共有 -> 独立ではないが同一でもない
		//
		//  旧方式(指数乱数の目標をLag3で繋ぐ)は平滑化したランダムウォークで、
		//  滑らかではあっても当てもなく彷徨うため、範囲を広げると激しくなり
		//  狭めると動かなくなる二律背反があった。回転は有界なまま動き続ける
		//  ので、これを解く。
		//
		//  速度比は 1 : 黄金比 : sqrt(2) : sqrt(3)。無理数比なので位相が
		//  揃う瞬間が存在しない。
		rates = [1.0, 1.6180340, 1.4142136, 1.7320508] * rotorHz;
		coss = SinOsc.kr(rates, pi/2);
		sins = SinOsc.kr(rates, 0);

		// 9本の座標へ射影する固定の重み。決定論的に作るので毎回同じ楽器になる。
		coords = Array.fill(9, { |i|
			wc = Array.fill(4, { |k| sin((i + 1) * 1.7 + (k * 2.3)) });
			ws = Array.fill(4, { |k| cos((i + 1) * 2.1 + (k * 1.3)) });
			(((coss * wc).sum + ((sins * ws).sum)) / 2.4)
		});

		// 座標0を音程へ。2^(x*range) なので有界。旧方式と混ぜられる。
		rotTarget  = baseFreq * (2 ** (coords[0] * rotorRange));
		randTarget = baseFreq * TExpRand.kr(rangeLo, rangeHi, trig);
		target = (rotTarget * rotor) + (randTarget * (1 - rotor));
		freq = Lag3.kr(target, glideTime);

		// ---- FM ----
		// 非整数の変調比で非調和な側帯波を作る。fmIndexが「きんきん」の量。
		// 側帯波は搬送波の音程に追従するので、滑走すると高域全体が一緒に動く。
		// これが「グライドして到達する高域」の実体。
		// FMの深さも回転の別座標から取る。音程とは位相がずれた形で連動するので、
		// 「明るさが音程とは違うタイミングで動く」という有機的な関係が生まれる。
		// 独立したLFOを別に足すのとは違い、同じ回転の別方向の射影になっている。
		mod = SinOsc.ar(freq * modRatio)
		    * freq
		    * (fmIndex * (1 + (coords[1] * 0.6 * timbreAmt * rotor)));
		car = SinOsc.ar(freq + mod);

		// わずかにずらした2本を左右へ。うなりが左右で揃わない。
		detA = SinOsc.ar((freq * 1.004) + mod) * 0.6;
		detB = SinOsc.ar((freq * 0.997) + mod) * 0.6;

		// ---- 振幅 ----
		// 目標更新のたびにアクセントを置くが、floorLevelを下回らないので
		// 音は途切れない。「常時鳴り続ける一本の声」という既定を守る。
		// Decay2は .kr で作る。trigがcontrol rateなので .ar に渡すと
		// 「first input is not audio rate」で組み立てに失敗する。
		// accentDurは0.1秒以上なのでcontrol rateで十分。
		env = floorLevel + ((1 - floorLevel) * Decay2.kr(trig, 0.01, accentDur) * accent);
		env = env * (1 + (SinOsc.kr(swellHz, 0.3) * 0.25)) * (1 + (coords[3] * 0.3 * rotor));

		sig = [car + detA, car + detB] * env * 0.3;

		// 明るさの蓋。音程に追従させるので、低い音は暗く高い音は明るくなる。
		cut = (freq * 8 * bright * (1 + (coords[2] * 0.5 * timbreAmt * rotor))).clip(200, 16000);
		sig = LPF.ar(sig, cut);

		sig = [
			(sig[0] * (1 - (width * 0.5))) + (sig[1] * (width * 0.5)),
			(sig[1] * (1 - (width * 0.5))) + (sig[0] * (width * 0.5))
		];

		sig = LeakDC.ar(sig);
		Out.ar(out, sig * amp);
	})
};

// ---- 3つの性格の既定値(レンダリング時の引数として使う) ----
//
//  きんきん:
//    baseFreq 470.24 targetRate 1.3 glideTime 0.45 rangeLo 0.8 rangeHi 5.0
//    fmIndex 4.5 modRatio 3.37 bright 1.4 accent 0.6
//
//  深み:
//    baseFreq 88.17 targetRate 0.5 glideTime 1.6 rangeLo 0.5 rangeHi 2.2
//    fmIndex 0.8 modRatio 1.51 bright 0.5 accent 0.3 floorLevel 0.7
//
//  ぴこぴこ:
//    baseFreq 470.24 targetRate 3.5 glideTime 0.09 rangeLo 0.5 rangeHi 4.0
//    fmIndex 1.2 modRatio 2.01 bright 1.1 accent 0.9 accentDur 0.1 floorLevel 0.15
//
