// =====================================================================
//  共有の空間段 — 連続体層と出来事層をまとめて残響へ送る
// =====================================================================
//
//  担当指標:
//      RT60推定 [s]        1.5 〜 2.6
//      LR相関              0.78 〜 0.94
//
//  当初はM1のSynthDefの中に残響を持たせていたが、次の2つの理由で外へ出した。
//
//  1. 持続音だけに残響をかけても知覚されない。M1に残響を足したE_残響ありは
//     残響なしのA_基準と聞き分けられなかった。残響が空間として聞こえるには
//     立ち上がりが要るので、出来事層と同じ残響を共有しなければ意味がない。
//  2. 層ごとに別々の残響を持つと、同じ部屋で鳴っているように聞こえない。
//
//  エコー(コムディレイ)は使わない。等間隔の反復は空間ではなくリズムとして
//  知覚され、持続音に対しては周期的な脈動しか生まないことが確認済み
//  ([[audio_visual/聴覚演出の音色探索は仕様を手放したSuperColliderのライブ楽器で行う.md]])。
//

~makeSpaceDef = {
	SynthDef(\space, { |in = 16, out = 0,
		mix = 0.28,        // 残響の量
		room = 42,         // 部屋の広さ [m]
		time = 2.1,        // 残響長 [s]。RT60の目標帯1.5〜2.6に対応
		damp = 0.55,       // 大きいほど尾が暗い
		spread = 3,        // 残響の左右の広がり。大きいとLR相関が下がる
		dry = 1.0,
		lag = 0.3|

		var src, wet;
		mix = Lag.kr(mix, lag);

		src = In.ar(in, 2);

		// GVerbはモノラル入力・ステレオ出力なので左右を混ぜて渡す
		wet = GVerb.ar(
			src.sum * 0.5,
			roomsize: room.clip(1, 290),
			revtime: time,
			damping: damp,
			inputbw: 0.6,
			spread: spread,
			drylevel: 0,
			maxroomsize: 300
		);

		// 素の音は必ず残す。残響は元の音を置き換えるものではない。
		Out.ar(out, (src * dry) + (wet * mix));
	})
};
