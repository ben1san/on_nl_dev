// =====================================================================
//  M2: 出来事層 — 共鳴体を叩いて減衰させる
// =====================================================================
//
//  この層が担う目標指標は4つ:
//      重心 p10-p90幅 [Hz]     ≥ 1000
//      スペクトル変化率のSD      ≥ 0.027
//      減衰イベント数 /30秒      ≥ 7
//      RT60推定 [s]            1.5 〜 2.6
//
//  M1(連続体層)は共鳴体をノイズで「鳴らし続ける」層だった。定常的な狭帯域
//  ノイズが固定周波数で鳴り続けるため、試聴では「蜂の羽ばたき」と評された。
//  この層は逆に、共鳴体を疎なインパルスで「叩いて」減衰させる。連続励起と
//  インパルス励起の違いが、そのままM1とM2の境界になっている。
//
//  M1のパラメータを何も変えず励起だけインパルスに差し替えた試作で、重心
//  p10-p90幅が 648 → 2049 へ跳ねた(目標1000を超える)。この層が無いと
//  達成できない指標であることは実測で確かめてある。
//
//  RT60もこの層に依存する。減衰イベントが存在しないと減衰時間は原理的に
//  測れないので、M1だけでは「測定不能」にしかならなかった。同じ理由で、
//  残響は持続音にかけても知覚されない(A_基準とE_残響ありが聞き分け不能
//  だった)。残響が空間として聞こえるには立ち上がりが要る。
//
//  ---- 既定値での実測(60秒レンダリング3回) ----
//
//      指標                  目標帯          M2実測          参照
//      2-8kHz [%]          0.9 〜 5.6    1.16 〜 2.30      1.28
//      LTAS平坦度           ≥ 0.024      0.088 〜 0.116    0.106
//      重心 p10-p90 [Hz]    ≥ 1000       1219 〜 1324      5782
//      変化率のSD           ≥ 0.027      0.0278 〜 0.0314  0.0286
//      減衰イベント数/30秒    ≥ 7          11.5 〜 17.5      4.0
//      RT60 [s]            1.5 〜 2.6    1.74 〜 2.25      1.69
//      LR相関              0.78 〜 0.94  0.768 〜 0.866    0.765
//      低音ピーク幅 [cent]   11 〜 33      13 〜 27          13
//
//  3回とも8指標すべて合格。ただし変化率のSDとLR相関は余裕が薄い。
//
//  **この層のばらつきは連続体層よりずっと大きい。** 発音がポアソン過程で、
//  1発ごとの高さも明るさも乱数なので、60秒でも 2-8kHz が ±13%、重心が
//  ±14% 動く。30秒だとさらに大きい。パラメータを比較するときは60秒以上で
//  レンダリングし、この幅より小さい差を読み取らないこと。
//
//  明るさには相反がある。pitchHi/brightHi を上げると 2-8kHz の余裕は増えるが
//  変化率のSDが下がる(明るい発音が増えると音色の変化が平均化されるため)。
//  既定値はこの2つの余裕が釣り合う位置に置いてある。
//
//  発音のタイミングはポアソン過程(Dust)で、周期を持たない。これは
//  [[audio_visual/消去イベントを直接音にするポアソン過程クリックとバッファ破壊という2案.md]]
//  が検討していた案と同じ構造で、将来この発火を実際の消去イベントへ
//  差し替えれば、そのままデータ駆動になる(M4)。
//

~makeEventsDef = {
	SynthDef(\events, { |out = 0, amp = 0.5,
		rate = 1.2,            // 1秒あたりの発音数(ポアソン過程の平均)
		baseFreq = 142.7,      // 連続体層と同じ基準の高さ
		pitchLo = 1.0,         // baseFreqに対する倍率の下限
		pitchHi = 8.5,         // 同上限。広いほど重心p10-p90幅が伸びる
		decMin = 0.9, decMax = 3.0,   // 減衰時間の範囲。RT60を直接決める
		excDur = 0.004,        // 叩く音の長さ。短いほど硬い
		excTone = 0.22,        // 0=暗い励起 / 1=明るい励起
		brightLo = 0.25, brightHi = 1.7,  // 1発ごとの明るさのばらつき
		spread = 0.5,          // 1発ごとの左右の振り分け幅
		lag = 0.2|

		var trig, trigK, freq, dec, bri, pan, exc, sig, ratios, decs;

		// ---- 発火: ポアソン過程。周期を持たない ----
		trig = Dust.ar(rate);
		// 1発ごとの値はコントロールレートで持つ。Ringzの周波数・減衰時間へ
		// オーディオレートの信号を渡すと音が出なくなる(NRTで無音になった)。
		// T2K で同じトリガをコントロールレートへ落として同期を保つ。
		trigK = T2K.kr(trig);

		// ---- 1発ごとの性格を発火の瞬間に決めて保持する ----
		// TExpRand/TRandはトリガ時にのみ新しい値を出し、次の発火まで保つ。
		// これで「1発ごとに違う」が成立する。重心のばらつきはここから来る。
		freq = baseFreq * TExpRand.kr(pitchLo, pitchHi, trigK);
		dec  = TExpRand.kr(decMin, decMax, trigK);
		bri  = TExpRand.kr(brightLo, brightHi, trigK);
		pan  = TRand.kr(-1.0, 1.0, trigK) * spread;

		// ---- 叩く音 ----
		// ごく短いノイズバースト。これが共鳴体を励起する。
		exc = Decay2.ar(trig, 0.0004, excDur)
		    * XFade2.ar(PinkNoise.ar(1), WhiteNoise.ar(1), (excTone * 2) - 1)
		    * 9;

		// ---- 共鳴体: 非調和な4本 ----
		// 整数倍にしないことで鐘や金属板に近い響きになる。倍率は
		// 円形膜の振動モード比にゆるく寄せてある。
		ratios = [1.0, 2.76, 5.40, 8.93];
		decs   = [1.0, 0.72, 0.55, 0.42];   // 高い部分音ほど速く減衰する
		sig = Ringz.ar(
			exc,
			freq * ratios,
			dec * decs
		) * [1.0, 0.55 * bri, 0.3 * bri, 0.18 * bri];
		sig = sig.sum * 0.25;

		// 明るさのばらつきをフィルタでも作る。重心の散らばりに効く。
		sig = LPF.ar(sig, (freq * 6 * bri).clip(200, 16000));

		sig = LeakDC.ar(sig);
		Out.ar(out, Pan2.ar(sig, pan, amp));
	})
};
