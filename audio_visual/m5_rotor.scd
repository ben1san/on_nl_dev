// =====================================================================
//  M5: 回転層 — スペクトルの上を膨らみが巡回する
// =====================================================================
//
//  試聴で「回転が感じられない」「どれもうねうねしている」と評された。
//  M4の回転実装が失敗していた原因は明確である。
//
//  M4は、通約でない4つの速度の正弦・余弦を**任意の重みで混ぜて**各パラメータ
//  (音程・FM深さ・明るさ・音量)へ配っていた。各パラメータの位相はバラバラに
//  なるので、これは準周期的な「うねり」であって循環ではない。数学的には確かに
//  SO(9)の軌道の射影だが、**知覚上の回転にはならない**。
//
//  回転が聞こえるには、同じ模様が順序を保って空間を移動しなければならない。
//  レスリースピーカーが回転して聞こえるのは、音量・音色・定位・ドップラーが
//  固定した位相差で連動し、何かが一方向へ巡るからである。位相をランダムに
//  配ってはいけない。
//
//  この層では、N本の部分音に 2*pi*k/N の**順序ある位相差**を与える。すると
//  スペクトル上を膨らみが低い方から高い方へ(あるいは逆へ)巡回し、一周すると
//  戻ってくる。定位にも同じ位相を与えるので、音は頭の周りを回る。
//
//  4枚の平面(SO(9)の実正規形)は保つ。主平面が部分音を巡回させ、残りの3枚が
//  通約でない速度で膨らみの幅・明るさ・全体の音量をゆっくり変える。これで
//  「厳密には決して繰り返さない回転」になる。
//
//  ---- 3つの性格は合成方式ごと変える ----
//
//  「音程の違いしかない」「そのまま適用した感じ」と評されたため、性格ごとに
//  パラメータではなく部分音の構成そのものを変える:
//
//    きんきん: 非調和な高い部分音・狭い膨らみ・速い巡回。金属質で刺す
//    深み    : 調和的な低い部分音・広い膨らみ・遅い巡回。太くうねる
//    ぴこぴこ: 少数の部分音・極めて狭い膨らみ・速い巡回。粒が跳ねる
//

~makeRotorDef = {
	SynthDef(\rotor, { |out = 0, amp = 0.3,
		baseFreq = 235.12,     // 470.24Hz(回路由来)の1オクターブ下
		rotorHz = 0.35,        // 巡回の速さ [周/秒]
		sharp = 3.0,           // 膨らみの狭さ。大きいほど1本ずつ点灯する
		spin = 1.0,            // +1=低->高へ巡回 / -1=高->低へ
		inharm = 0.0,          // 0=調和的 / 大きいほど非調和(金属質)
		tilt = 0.8,            // 高い部分音の減衰。小さいほど明るい
		orbit = 0.8,           // 定位も一緒に回す量。0=中央固定
		floorLevel = 0.12,     // 膨らみの外でも残る音量
		fm = 0.0,              // 各部分音にかけるFMの深さ
		modRatio = 2.41,
		gate = 0.0,            // 1に近いほど各部分音が点滅する(ぴこぴこ用)
		gateHz = 6.0,
		// ---- 巡回を何に対して等速にするか ----
		// 0 = 部分音の番号に対して等速。1本ずつ順に点灯するが、周波数で見ると
		//     1->2倍音(1オクターブ)を1/12周期で駆け抜け、6->12倍音(同じ1オク
		//     ターブ)に半周かける。耳が感じる掃引は上昇中ずっと減速している。
		// 1 = 対数周波数に対して等速。オクターブ/秒が一定になる。参照録音から
		//     測った掃引速度は重心=対数側の量なので、比べるならこちら。
		// 試聴で「奥行きが一番いい」と評されたため1を既定とする。
		// **ただし明るい音色(tiltが小さい)では1にしてはいけない。** 対数写像は
		// 位相の進みを最低音の数本に集中させるので、高い部分音が主役の音色では
		// 聞こえている帯域がほぼ同位相になり、回転がトレモロへ潰れる(きんきんで
		// 順行性0.865→0.229)。その場合は0か、次のphaseEqualを使う。
		phaseMap = 1.0,
		// 部分音の音量の累積で位相を配る。**聞こえているエネルギーに対して等速**
		// になるので、tiltやinharmを変えても位相の進みが偏らない。1にすると
		// phaseMapを上書きする。
		phaseEqual = 0.0,
		// ---- ドップラー ----
		// レスリーが回って聞こえるのは、音量・定位・**音高**が固定した位相差で
		// 連動するからである。この層は音量と定位しか回しておらず、音高は回転に
		// 関与していない。音高の振れ幅を広げるとサイレンになるという既定は
		// 0.25〜0.7オクターブの話で、ここで足すのは数セント(0.3〜1%)。桁が2つ違う。
		// 各部分音は巡回上の別の位置にいるので、それぞれ別の向きへずれる。
		// 試聴で採用。0.012で約21セント。
		doppler = 0.012,
		// ---- 何が回っているのか ----
		// 0 = 回転木馬。部分音ごとに定位が固定され、順に点灯する。**各部分音の
		//     定位は時間的に一切動かない**(cos(phases[i])は定数で、動くのは
		//     「今どれが鳴っているか」だけ)。並んだランプが順に光るモデル。
		// 1 = 単一音源の周回。全部分音が定位もドップラーも同じ位相を共有し、
		//     音像がひとつの物体として頭の周りを回る。膨らみの巡回は残るので、
		//     「回りながら音色が変わる一個の物体」になる。
		orbitMode = 0.0,
		// ---- 第2の回転面(歳差) ----
		// SO(9)の残る3枚はこれまでスカラーLFOに格下げされており、何も回して
		// いなかった。ここでは別の波数と通約でない速さを持つ第2の順序ある位相場を
		// 重ねる。膨らみが巡りながら、強く出る領域そのものもゆっくり巡る。
		precess = 0.0,
		precessRatio = 1.6180340,
		// 第2の場の波数。**2以上にしてはいけない。** 部分音は12本しかないので、
		// 波数2では低音側で隣との位相差がπを超え、進行波として成立しない
		// (順行性0.067と、実際に検出できないところまで崩れる)。
		precessWave = 1.0,
		// ---- 対向回転 ----
		// 逆向きに巡る第2の膨らみを重ねる。すれ違う瞬間だけ振幅が突出し、
		// **回転に内在する出来事**が生まれる。ポアソン過程で独立に撃つ出来事層と
		// 違い、連続な回転から出てくるので軌跡が飛ばない。
		counter = 0.0,
		counterRatio = 0.93,     // 主回転との速度比。1から外すほど交差が巡る
		// ---- 空間の広がり ----
		// 「深い」は低い音ではなく広がりである、と試聴で二度指摘された。
		// 音域を下げるのではなく、部分音を空間へ散らすことで作る。
		spreadOct = 0.0,       // 部分音をオクターブ方向へ広げる量。
		                       // 0=密な倍音列 / 大きいほど帯域全体へ散る
		panSpin = 0.0,         // 部分音ごとに独立した速度で定位を巡らせる量。
		                       // orbitは位置が固定、これは位置自体が動く
		lag = 0.3|

		var n = 12, k, ratios, freqs, phases, bump, bumpC, amps, sig, l, r, wts, wSum;
		var pMod, pWidth, pBright, pLevel, rates;

		baseFreq = Lag.kr(baseFreq, lag);
		amp = Lag.kr(amp, lag);

		// ---- SO(9)の残り3枚の平面 ----
		// 主平面(巡回)以外は、通約でない速度で膨らみの性質をゆっくり変える。
		// 位相が揃う瞬間が原理的に存在しないので、一周ごとに少しずつ違う。
		rates = [1.6180340, 1.4142136, 1.7320508] * rotorHz;
		pWidth  = SinOsc.kr(rates[0], 0.0).range(0.6, 1.6);
		pBright = SinOsc.kr(rates[1], 1.1).range(0.7, 1.4);
		pLevel  = SinOsc.kr(rates[2], 2.3).range(0.75, 1.0);

		// ---- 部分音 ----
		// inharmで非調和にずらす。整数倍から外れるほど金属質になる。
		k = (0..(n - 1));
		ratios = k.collect({ |i|
			var base = (i + 1) + (inharm * ((i + 1) ** 1.4 - (i + 1)));
			// spreadOctで部分音をオクターブ方向へ引き伸ばす。倍音列が
			// 密に固まっていると「低い音」に聞こえるだけで広がらない。
			base * (2 ** (spreadOct * i / n))
		});
		freqs = ratios * baseFreq;

		// ---- 巡回する膨らみ ----
		// **ここがこの層の全部。** 部分音kの位相を 2*pi*k/n だけずらす。
		// 位相差が順序を保っているので、膨らみがスペクトル上を一方向へ移動し、
		// 一周すると戻ってくる。ランダムな位相にすると、これがただの
		// うねりに戻る(M4の失敗)。
		// phaseMapで「番号に等速」と「対数周波数に等速」を混ぜる。どちらも
		// 最上部分音で 2pi*(n-1)/n に着くよう正規化してあるので、切り替えても
		// 一周の量は変わらない(変わるのは道中の速さの配分だけ)。
		// 音量の累積。位相を「聞こえているエネルギー」に対して等速に配るための座標。
		wts = ratios.collect({ |ra| ra ** tilt.neg });
		wSum = wts.sum;
		phases = k.collect({ |i|
			var uIdx = i / n;
			var uOct = ratios[i].log2 / ratios[n - 1].log2.max(1e-6) * ((n - 1) / n);
			var uEq = if (i == 0) { 0.0 } { wts.copyRange(0, i - 1).sum / wSum };
			var uMix = (uIdx * (1 - phaseMap)) + (uOct * phaseMap);
			2pi * ((uMix * (1 - phaseEqual)) + (uEq * phaseEqual)) * spin
		});
		bump = k.collect({ |i|
			var x = SinOsc.kr(rotorHz, phases[i]).max(0);
			floorLevel + ((1 - floorLevel) * (x ** (sharp * pWidth)))
		});

		// 逆向きに巡る第2の膨らみ。速度比が1でないので交差点そのものが巡る。
		bumpC = k.collect({ |i|
			var x = SinOsc.kr(rotorHz * counterRatio, phases[i].neg).max(0);
			floorLevel + ((1 - floorLevel) * (x ** (sharp * pWidth)))
		});
		bump = (bump + (counter * bumpC)) / (1 + counter);

		// 第2の回転面。順序ある位相場をもう一枚重ねる(スカラーLFOではない)。
		bump = bump * k.collect({ |i|
			1 - precess + (precess * SinOsc.kr(
				rotorHz * precessRatio, phases[i] * precessWave).range(0, 1))
		});

		// 高い部分音ほど小さく
		amps = ratios.collect({ |ra| ra ** tilt.neg });

		// ドップラー。音量が最大になる1/4周期**前**に音高が最大になるよう、
		// 巡回と同じ位相からpi/2ずらす(近づきながら明るくなり、遠ざかりながら暗く
		// なる)。位相を共有しているので、これも巡回の一部として回る。
		// orbitMode=1では全部分音が同じ位相を共有する = 一個の物体のドップラー。
		freqs = freqs * k.collect({ |i|
			1 + (doppler * SinOsc.kr(rotorHz, (phases[i] * (1 - orbitMode)) + 0.5pi))
		});

		// 各部分音。fmが0なら素の正弦。
		sig = SinOsc.ar(
			freqs + (SinOsc.ar(freqs * modRatio) * freqs * fm * pBright)
		) * bump * amps;

		// 点滅(ぴこぴこ用)。巡回と同じ位相を使うので、粒も回る。
		sig = sig * k.collect({ |i|
			1 - (gate * SinOsc.kr(gateHz, phases[i]).range(0, 1))
		});

		// ---- 定位も同じ位相で回す ----
		// スペクトルの巡回と空間の巡回が同期するので、
		// 「音が頭の周りを回る」感じが出る。
		// panSpinを入れると、部分音ごとに別々の遅い速度で定位が巡る。
		// 12本が別々の場所を別々の速さで回るので、音像が広がって定まらない。
		// orbitMode=0は cos(phases[i]) すなわち**時間的に動かない固定位置**で、
		// 音像が動いて聞こえるのは鳴っている部分音が入れ替わるからにすぎない。
		// orbitMode=1では全部分音が同じ正弦で左右に振れ、音像が一体で周回する。
		pMod = k.collect({ |i|
			((cos(phases[i]) * (1 - orbitMode))
				+ (SinOsc.kr(rotorHz, 0.5pi) * orbitMode)) * orbit
			+ (SinOsc.kr(rotorHz * (0.31 + (i * 0.13)), phases[i]) * panSpin)
		});
		l = k.collect({ |i| sig[i] * (0.5 + (0.5 * pMod[i].clip(-1, 1))) }).sum;
		r = k.collect({ |i| sig[i] * (0.5 - (0.5 * pMod[i].clip(-1, 1))) }).sum;

		sig = [l, r] * 0.16 * pLevel;
		sig = LeakDC.ar(sig);
		Out.ar(out, sig * amp);
	})
};

// ---- 3つの性格(合成の構成ごと変える) ----
//
//  きんきん: inharm 0.35 sharp 5.0 rotorHz 0.7 tilt 0.35 fm 0.8 modRatio 3.37
//            baseFreq 235.12 orbit 0.9 **phaseMap 0**
//  深み    : inharm 0.0  sharp 1.6 rotorHz 0.18 tilt 1.1 fm 0.0
//            baseFreq 88.17 orbit 0.6 floorLevel 0.3
//  ぴこぴこ: inharm 0.12 sharp 9.0 rotorHz 0.9 tilt 0.6 fm 0.0
//            baseFreq 470.24 orbit 1.0 gate 0.8 gateHz 7.0 floorLevel 0.02
//
//  ---- phaseMapは性格ごとに決まる。既定値をそのまま当ててはいけない ----
//
//  ドップラーは3性格すべてで回転を保つので大域的に足してよい。対数写像は違う。
//  位相の進みが最低音の数本に集中するため、高い部分音が主役の音色では破綻する。
//  回転指数(audio_visual/rotation_index.py)での実測:
//
//      性格        phaseMap 0     phaseMap 1     判定
//      きんきん      0.865(回転)    0.229(トレモロ)  0のまま使う
//      深み        1.000(回転)    1.000(回転)     1でよい
//      ぴこぴこ      0.999(回転)    1.000(回転)     1でよい
//
//  phaseEqual(音量の累積で配る)は音色に自動追従するが、きんきんでは0.656に
//  留まり phaseMap 0 に及ばなかった。tiltが極端な性格では素直に0を使う。
//
