// =====================================================================
//  系統Aの空間段 — リバーブのみ。ディレイは使わない
// =====================================================================
//
//  コムディレイは使わない。等間隔の反復は人間の耳が即座に検出するため、
//  空間ではなくリズム(毎秒1.4〜2.9回の脈動)として知覚される。既存の試聴で
//  「ヘリコプターのように機械的」と評された経路であり、切れ目のない音に
//  対しては原理的に空間を作れない。空間はリバーブだけに担わせる。
//
//  残響長は1.7秒。蓄積した試聴評価13件のうち好評だったものは一貫して
//  RT60が1.71〜1.74秒で、不評は2.17〜2.46秒だった。参照の目標帯は
//  1.5〜2.6秒と広いが、その中の短い側が好まれている。
//
//  系統A自身のRT60は測定不能だった(発音0.51/sでは減衰イベントが足りない)。
//  したがって1.7秒は参照の系統Aから引いた値ではなく、試聴評価から引いた値。
//
~makeSysASpaceDef = {
	SynthDef(\sysASpace, { |in = 16, out = 0, mix = 0.35,
		room = 40,            // 部屋の広さ [m]
		time = 1.7,           // 残響長 [s]
		damp = 0.65,          // 高域の減衰。暗さを保つため強め
		lo = 120, hi = 3500,  // 残響の帯域。低域の濁りを削り籠りを避ける
		width = 0.35,         // 残響の左右非相関をどれだけ残すか
		gain = 1.6,           // 出力ゲイン。参照AのRMS -18.6dBに合わせた値
		// 圧縮の閾値と天井。**これは演出ではなく波高率の整合である。** 圧縮前は
		// ピークが0.0dBに張り付いてクリップしているのにRMSは-24.2dBで、波高率
		// 24dB。参照Aは13.4dB(ピーク-5.2dB/RMS-18.6dB)。まれに来る巨大なピークが
		// 天井を占有して平均レベルを押し下げており、これが「重みがない」の実体
		// だった。床の音色を変えても印象が変わらなかったのも同じ理由による。
		thresh = 0.12, ceil = 0.56|
		var dry = In.ar(in, 2);
		var sig;
		// **引数の順序に注意。** GVerbは (in, roomsize, revtime, damping,
		// inputbw, spread, drylevel, earlyreflevel, taillevel, maxroomsize) で、
		// 9番目は maxroomsize ではなく taillevel である。ここに300を置くと
		// 残響の尾に300倍のゲインがかかり、持続音では原音を完全に覆う。
		// 症状は無音でも歪みでもなく「音像の周回が消え、スペクトルが平坦に
		// なり、高域が持ち上がる」という間接的なもので、原因の特定に手間が
		// かかった(音像の振れ幅が周回幅を0.05から0.34へ上げても0.003のまま
		// 動かず、素の音では0.477出ていたことでようやか切り分けられた)。
		var wet = GVerb.ar(dry.sum * 0.5, room, time, damp, 0.5, 15, 0, 0.7, 0.5, 300);
		wet = HPF.ar(LPF.ar(wet, hi), lo);
		// **広がりの主因は定位ではなく残響である。** 部分音の定位の振れ幅を
		// 0.7→0.22へ下げてもSideは20.98%→32.47%と増え続けた。GVerbの2出力は
		// ほぼ非相関なので、参照の実測(LR相関0.762・Side 12%)へ寄せるには
		// 残響側をモノ寄りへ潰す必要がある。
		wet = (wet * width) + (wet.sum * 0.5 * (1 - width));
		sig = ((dry * (1 - mix)) + (wet * mix)) * gain;
		// 緩い圧縮で密度を上げ、最後に天井で頭を止める
		// リリースを2.5秒と長く採る。**0.3秒では参照の変調の主帯域(0.3Hz以下に
		// 72%)を圧縮器が追いかけて潰してしまう。** 圧縮は波高率の整合だけに使い、
		// ゆっくりした息には触らせない。
		sig = CompanderD.ar(sig, thresh, 1.0, 0.4, 0.05, 2.5);
		sig = Limiter.ar(sig, ceil, 0.01);
		Out.ar(out, sig);
	})
};
